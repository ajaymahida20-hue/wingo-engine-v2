# Password that protects the control panel. If this is left unset the built-in
# default "012m24" is used — set your own here or in the host's dashboard instead,
# because the panel can read your bot token.
PANEL_PASSWORD=change-me

# Port the panel listens on. Render sets PORT itself, so usually leave this alone.
PORT=3001

# Optional welcome instruction video (Telegram file_id or video URL)
WELCOME_VIDEO=

# Where the state file lives. On Render attach a disk and point this at it,
# otherwise every restart/redeploy wipes the saved channels and subscribers.
DATA_DIR=./data

# How often the lottery history is polled, in milliseconds.
POLL_MS=2000
